{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clatterforge",
  "version": "0.1.0",
  "identifier": "dev.conductor.gui",
  "build": {
    "frontendDist": "../target/dx/conductor-gui/release/web/public",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "dx serve",
    "beforeBuildCommand": "dx build --release --platform web --locked"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clatterforge // CF Systems",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
